# Ambiente de desenvolvimento para os exemplos eBPF do minicurso.
# Roda em modo privilegiado (ver docker-compose.yml) porque carregar programas
# eBPF no kernel exige CAP_BPF/CAP_SYS_ADMIN, e o kernel observado é sempre o
# do host (containers compartilham o mesmo kernel).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        llvm \
        lld \
        libbpf-dev \
        libelf-dev \
        zlib1g-dev \
        make \
        git \
        python3 \
        python3-pip \
        python3-bpfcc \
        iproute2 \
        iputils-ping \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# bpftool via pacote (linux-tools-*) é um script que despacha para um binário
# específico da versão de kernel da distro do container — quebra porque o
# container roda sobre o kernel do host, que normalmente é outra versão.
# O binário estático oficial do projeto não tem essa amarração.
ARG BPFTOOL_VERSION=v7.7.0
RUN ARCH=$(dpkg --print-architecture) \
    && curl -sL "https://github.com/libbpf/bpftool/releases/download/${BPFTOOL_VERSION}/bpftool-${BPFTOOL_VERSION}-${ARCH}.tar.gz" \
        | tar -xz -C /usr/local/bin bpftool \
    && chmod +x /usr/local/bin/bpftool

WORKDIR /workspace
