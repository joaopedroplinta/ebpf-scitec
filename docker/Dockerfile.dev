# Ambiente de desenvolvimento para os exemplos eBPF do minicurso.
# Roda em modo privilegiado (ver docker-compose.yml) porque carregar programas
# eBPF no kernel exige CAP_BPF/CAP_SYS_ADMIN, e o kernel observado é sempre o
# do host (containers compartilham o mesmo kernel).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        llvm \
        lld \
        libbpf-dev \
        libelf-dev \
        zlib1g-dev \
        make \
        git \
        python3 \
        python3-pip \
        python3-bpfcc \
        iproute2 \
        iputils-ping \
        curl \
        ca-certificates \
    && (apt-get install -y --no-install-recommends bpftool \
        || apt-get install -y --no-install-recommends linux-tools-generic) \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
